shader_type canvas_item;
render_mode unshaded;

// Restore the Aseprite palette after the 3D colour pipeline.
const vec3 PALETTE[27] = vec3[](vec3(0.10588235294117647,0.043137254901960784,0.058823529411764705),
    vec3(0.1607843137254902,0.06274509803921569,0.08235294117647059),
    vec3(0.23921568627450981,0.12941176470588237,0.11372549019607843),
    vec3(0.21176470588235294,0.11372549019607843,0.13333333333333333),
    vec3(0.23529411764705882,0.14901960784313725,0.16862745098039217),
    vec3(0.3607843137254902,0.12549019607843137,0.14901960784313725),
    vec3(0.4470588235294118,0.26666666666666666,0.20784313725490197),
    vec3(0.3254901960784314,0.23529411764705882,0.26666666666666666),
    vec3(0.3568627450980392,0.2627450980392157,0.28627450980392155),
    vec3(0.6313725490196078,0.13725490196078433,0.2),
    vec3(0.8,0.1803921568627451,0.22745098039215686),
    vec3(0.592156862745098,0.2901960784313726,0.20392156862745098),
    vec3(0.8196078431372549,0.3686274509803922,0.20392156862745098),
    vec3(0.7215686274509804,0.1803921568627451,0.2549019607843137),
    vec3(0.8509803921568627,0.21568627450980393,0.25882352941176473),
    vec3(0.6196078431372549,0.396078431372549,0.3176470588235294),
    vec3(0.8549019607843137,0.41568627450980394,0.2784313725490196),
    vec3(0.7333333333333333,0.5176470588235295,0.23529411764705882),
    vec3(0.9450980392156862,0.6,0.2196078431372549),
    vec3(0.9725490196078431,0.7725490196078432,0.23921568627450981),
    vec3(0.7058823529411765,0.5490196078431373,0.4196078431372549),
    vec3(0.9607843137254902,0.6666666666666666,0.3254901960784314),
    vec3(0.9882352941176471,0.807843137254902,0.396078431372549),
    vec3(0.7372549019607844,0.6078431372549019,0.5137254901960784),
    vec3(0.9490196078431372,0.6823529411764706,0.5372549019607843),
    vec3(0.9882352941176471,0.8470588235294118,0.6470588235294118),
    vec3(0.984313725490196,0.8941176470588236,0.7647058823529411));

void fragment() {
    vec4 sample_color = texture(TEXTURE, UV);
    vec3 nearest = PALETTE[0];
    float best = 10.0;
    for (int i = 0; i < 27; i++) {
        vec3 difference = sample_color.rgb - PALETTE[i];
        float distance_squared = dot(difference, difference);
        if (distance_squared < best) {
            best = distance_squared;
            nearest = PALETTE[i];
        }
    }
    COLOR = sample_color.a < 0.5 ? vec4(0.0) : vec4(nearest, 1.0);
}
